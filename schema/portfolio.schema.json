{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stuttter/.github/main/schema/portfolio.schema.json",
  "title": "WordPress plugin portfolio inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositories"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "enabled", "managed_paths", "manifest", "checks", "integration"],
        "allOf": [
          {
            "if": {
              "properties": {
                "managed_paths": {
                  "contains": { "const": "release" }
                }
              },
              "required": ["managed_paths"]
            },
            "then": {
              "properties": {
                "manifest": {
                  "properties": {
                    "wordpress_org": { "const": true }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "checks": {
                  "properties": {
                    "smoke": { "required": ["multisite"] }
                  },
                  "required": ["smoke"]
                }
              },
              "required": ["checks"]
            },
            "then": {
              "properties": {
                "manifest": {
                  "properties": {
                    "multisite": { "const": true }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "enabled": { "type": "boolean" },
          "managed_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["ci", "release", "dependabot"]
            }
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phpunit"],
            "properties": {
              "phpunit": {
                "oneOf": [
                  { "const": false },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["config", "files"],
                    "properties": {
                      "config": { "const": "phpunit.xml.dist" },
                      "files": {
                        "type": "array",
                        "minItems": 4,
                        "uniqueItems": true,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["path", "sha256"],
                          "properties": {
                            "path": {
                              "type": "string",
                              "pattern": "^(?!.*[\\r\\n])(?:composer\\.(?:json|lock)|phpunit\\.xml\\.dist|\\.?phpcs\\.xml(?:\\.dist)?|(?:bin|scripts|tests)/(?!.*\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+)$"
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "node": {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "script", "scripts", "files"],
                "properties": {
                  "version": { "enum": ["22", "24"] },
                  "script": { "const": "build:check" },
                  "scripts": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": { "pattern": "^[A-Za-z0-9:_-]+$" },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9_./:@=-]+(?: +[A-Za-z0-9_./:@=-]+)*(?: +&& +[A-Za-z0-9_./:@=-]+(?: +[A-Za-z0-9_./:@=-]+)*)*$"
                    }
                  },
                  "files": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["path", "sha256"],
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^(?!.*[\\r\\n])(?!/)(?!.*\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*$"
                        },
                        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                      }
                    }
                  }
                }
              },
              "smoke": {
                "type": "object",
                "additionalProperties": false,
                "required": ["payloads", "files"],
                "minProperties": 2,
                "properties": {
                  "single_site": {
                    "type": "string",
                    "pattern": "^(?!.*[\\r\\n])(?:bin|tests)/(?!.*\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.sh$"
                  },
                  "multisite": {
                    "type": "string",
                    "pattern": "^(?!.*[\\r\\n])(?:bin|tests)/(?!.*\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.sh$"
                  },
                  "payloads": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "single_site": {
                        "type": "string",
                        "pattern": "^(?!.*[\\r\\n])(?:bin|tests)/(?!.*\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.php$"
                      },
                      "multisite": {
                        "type": "string",
                        "pattern": "^(?!.*[\\r\\n])(?:bin|tests)/(?!.*\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.php$"
                      }
                    }
                  },
                  "files": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["path", "sha256"],
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^(?!.*[\\r\\n])(?:composer\\.(?:json|lock)|phpunit\\.xml\\.dist|\\.?phpcs\\.xml(?:\\.dist)?|(?:bin|scripts|tests)/(?!.*\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+)$"
                        },
                        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                      }
                    }
                  }
                }
              }
            }
          },
          "integration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plugin_check": { "const": true },
              "wordpress": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "const": "tests/integration/smoke.php" },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          "protection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["extra_required_checks"],
            "properties": {
              "extra_required_checks": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\r\\n]+$"
                }
              }
            }
          },
          "manifest": {
            "$ref": "plugin-standard.schema.json"
          }
        }
      }
    }
  }
}
